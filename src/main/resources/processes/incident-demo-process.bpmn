<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   id="Definitions_incident_demo"
                   targetNamespace="http://camunda.example.com/incident-demo">

    <bpmn:process id="incidentDemoProcess" name="Incident Demo Process" isExecutable="true">
        <bpmn:startEvent id="StartEvent_1" name="Start">
            <bpmn:outgoing>Flow_1</bpmn:outgoing>
        </bpmn:startEvent>

        <!--
          asyncBefore="true" makes this an asynchronous continuation: a job is created
          and executed by the job executor (or manually via ManagementService.executeJob
          in tests) rather than inline on the starting thread. failedJobRetryTimeCycle
          "R0/PT1M" means zero retries remain after the very first failure, so a
          failedJob incident is raised immediately on first execution instead of only
          after several automatic retries.
        -->
        <bpmn:serviceTask id="ServiceTask_Fail" name="Always Fails"
                           camunda:asyncBefore="true"
                           camunda:delegateExpression="${simulatedFailureDelegate}">
            <bpmn:extensionElements>
                <camunda:failedJobRetryTimeCycle>R0/PT1M</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_1</bpmn:incoming>
            <bpmn:outgoing>Flow_2</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_1" name="End">
            <bpmn:incoming>Flow_2</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_Fail"/>
        <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_Fail" targetRef="EndEvent_1"/>
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                         xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                         xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="incidentDemoProcess">
            <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
                <omgdc:Bounds x="150" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="ServiceTask_Fail_di" bpmnElement="ServiceTask_Fail">
                <omgdc:Bounds x="260" y="78" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
                <omgdc:Bounds x="440" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
                <omgdi:waypoint x="186" y="118"/>
                <omgdi:waypoint x="260" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
                <omgdi:waypoint x="360" y="118"/>
                <omgdi:waypoint x="440" y="118"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
