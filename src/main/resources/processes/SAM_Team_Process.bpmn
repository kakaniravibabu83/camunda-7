<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SAM" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:message id="Message_Stage1Ready" name="Stage1ReadyMessage" />
  <bpmn:message id="Message_Stage1Idle" name="Stage1IdleMessage" />
  <bpmn:message id="Message_Stage2Ready" name="Stage2ReadyMessage" />
  <bpmn:message id="Message_Stage2Idle" name="Stage2IdleMessage" />
  <bpmn:message id="Message_Stage3Idle" name="Stage3IdleMessage" />
  <bpmn:process id="Process_SAM_Team" name="SAM Team Staged Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Process Instance Created">
      <bpmn:outgoing>Flow_Start_To_Fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Open Case">
      <bpmn:incoming>Flow_Start_To_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_To_SamTeam</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_To_Stage1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Start_To_Fork" sourceRef="StartEvent_1" targetRef="Gateway_Fork" />
    <bpmn:userTask id="UserTask_SamTeam" name="SAM Team" camunda:candidateGroups="SAM_Team">
      <bpmn:documentation>Stays open for the life of the case. SAM team checks that all tasks they care about (across any stage) are complete, then either (a) leaves this open and keeps triggering tasks in any opened stage via API, or (b) completes this task to close the case, which terminates everything still running.</bpmn:documentation>
      <bpmn:incoming>Flow_Fork_To_SamTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_SamTeam_To_Terminate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Fork_To_SamTeam" sourceRef="Gateway_Fork" targetRef="UserTask_SamTeam" />
    <bpmn:endEvent id="EndEvent_Terminate" name="Close Case">
      <bpmn:incoming>Flow_SamTeam_To_Terminate</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SamTeam_To_Terminate" sourceRef="UserTask_SamTeam" targetRef="EndEvent_Terminate" />
    <bpmn:sequenceFlow id="Flow_Fork_To_Stage1" sourceRef="Gateway_Fork" targetRef="Stage_1" />
    <bpmn:subProcess id="Stage_1" name="Stage 1">
      <bpmn:incoming>Flow_Fork_To_Stage1</bpmn:incoming>
      <bpmn:outgoing>Flow_Stage_1_Boundary_Out</bpmn:outgoing>
      <bpmn:startEvent id="Stage_1_Start" name="Stage Opened">
        <bpmn:outgoing>Stage_1_Flow_StartToWait</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:receiveTask id="Stage_1_KeepAlive" name="Stage&#10;Active (kept alive)" messageRef="Message_Stage1Idle">
        <bpmn:incoming>Stage_1_Flow_StartToWait</bpmn:incoming>
        <bpmn:outgoing>Stage_1_Flow_WaitToEnd</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="Stage_1_End">
        <bpmn:incoming>Stage_1_Flow_WaitToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Stage_1_Flow_StartToWait" sourceRef="Stage_1_Start" targetRef="Stage_1_KeepAlive" />
      <bpmn:sequenceFlow id="Stage_1_Flow_WaitToEnd" sourceRef="Stage_1_KeepAlive" targetRef="Stage_1_End" />
      <bpmn:userTask id="Stage1_Task_A" name="Stage 1 - Task A" camunda:candidateGroups="SAM_Team">
        <bpmn:documentation>Triggered on demand via Process Instance Modification API, scoped to this Stage 1 sub-process instance. SAM team's sole choice - any task, any order, any count, any time - including after other stages have opened.</bpmn:documentation>
      </bpmn:userTask>
      <bpmn:userTask id="Stage1_Task_B" name="Stage 1 - Task B" camunda:candidateGroups="SAM_Team">
        <bpmn:documentation>Triggered on demand via Process Instance Modification API, scoped to this Stage 1 sub-process instance. SAM team's sole choice - any task, any order, any count, any time - including after other stages have opened.</bpmn:documentation>
      </bpmn:userTask>
      <bpmn:userTask id="Stage1_Task_C" name="Stage 1 - Task C" camunda:candidateGroups="SAM_Team">
        <bpmn:documentation>Triggered on demand via Process Instance Modification API, scoped to this Stage 1 sub-process instance. SAM team's sole choice - any task, any order, any count, any time - including after other stages have opened.</bpmn:documentation>
      </bpmn:userTask>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Stage_1_Ready" name="Ready for Next Stage" cancelActivity="false" attachedToRef="Stage_1">
      <bpmn:outgoing>Flow_Stage_1_Boundary_Out</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Boundary_Stage_1_Ready_MsgDef" messageRef="Message_Stage1Ready" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Stage_1_Boundary_Out" sourceRef="Boundary_Stage_1_Ready" targetRef="Stage_2" />
    <bpmn:subProcess id="Stage_2" name="Stage 2">
