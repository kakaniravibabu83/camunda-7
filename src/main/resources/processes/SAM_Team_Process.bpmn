    <bpmn:sequenceFlow id="Flow_Stage_2_Boundary_Out" sourceRef="Boundary_Stage_2_Ready" targetRef="Stage_3" />
    <bpmn:subProcess id="Stage_3" name="Stage 3">
      <bpmn:incoming>Flow_Stage_2_Boundary_Out</bpmn:incoming>
