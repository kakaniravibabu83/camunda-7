  <bpmn:process id="StagedProcess" name="Staged Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Process Instance Created">
      <bpmn:outgoing>Flow_Start_To_Fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Open Case">
      <bpmn:incoming>Flow_Start_To_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_To_SamTeam</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_To_Stage1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Start_To_Fork" sourceRef="StartEvent_1" targetRef="Gateway_Fork" />
    <bpmn:userTask id="UserTask_SamTeam" name="SAM Team" camunda:candidateGroups="SAM_Team">
      <bpmn:documentation>Stays open for the life of the case. SAM team checks that all tasks they care about are complete, then either (a) leaves this open and keeps triggering tasks in the current stage via API, or (b) completes this task to close the case. Completing this task also correlates CaseCloseMessage (via the API layer), which cancels whichever stage is currently open through its interrupting boundary event, so both branches reach EndEvent_CaseClosed together and the process instance completes naturally.</bpmn:documentation>
      <bpmn:incoming>Flow_Fork_To_SamTeam</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Fork_To_SamTeam" sourceRef="Gateway_Fork" targetRef="UserTask_SamTeam" />
    <bpmn:sequenceFlow id="Flow_Fork_To_Stage1" sourceRef="Gateway_Fork" targetRef="Stage_1" />
    <bpmn:subProcess id="Stage_1" name="Stage 1">
      <bpmn:incoming>Flow_Fork_To_Stage1</bpmn:incoming>
      <bpmn:startEvent id="Stage_1_Start" name="Stage Opened">
        <bpmn:outgoing>Stage_1_Flow_StartToWait</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:receiveTask id="Stage_1_KeepAlive" name="Stage Active (kept alive)" messageRef="Message_Stage1Idle">
        <bpmn:incoming>Stage_1_Flow_StartToWait</bpmn:incoming>
        <bpmn:outgoing>Stage_1_Flow_WaitToEnd</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="Stage_1_End">
        <bpmn:incoming>Stage_1_Flow_WaitToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Stage_1_Flow_StartToWait" sourceRef="Stage_1_Start" targetRef="Stage_1_KeepAlive" />
      <bpmn:sequenceFlow id="Stage_1_Flow_WaitToEnd" sourceRef="Stage_1_KeepAlive" targetRef="Stage_1_End" />
      <bpmn:userTask id="Stage1_Task_A" name="Stage 1 - Task A" camunda:candidateGroups="SAM_Team">
        <bpmn:documentation>Triggered on demand via Process Instance Modification API, scoped to this Stage 1 sub-process instance. SAM team's sole choice - any task, any order, any count, any time. Once this stage is completed and the next stage opens (or the case is closed), this stage is closed and can no longer be triggered.</bpmn:documentation>
      </bpmn:userTask>
      <bpmn:userTask id="Stage1_Task_B" name="Stage 1 - Task B" camunda:candidateGroups="SAM_Team">
        <bpmn:documentation>Triggered on demand via Process Instance Modification API, scoped to this Stage 1 sub-process instance. SAM team's sole choice - any task, any order, any count, any time. Once this stage is completed and the next stage opens (or the case is closed), this stage is closed and can no longer be triggered.</bpmn:documentation>
