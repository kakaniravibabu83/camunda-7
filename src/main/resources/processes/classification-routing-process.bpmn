<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_classification_routing" targetNamespace="http://camunda.example.com/classification-routing" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="classificationRoutingProcess" name="Classification Routing Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Request Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="BusinessRuleTask_Classify" name="Evaluate Classification" camunda:resultVariable="classificationType" camunda:decisionRef="classificationDecision" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="CallActivity_RouteToHandler" name="Route To Handler" calledElement="${classificationType == &#39;URGENT&#39; ? &#39;urgentHandlerProcess&#39;      : (classificationType == &#39;PRIORITY&#39; ? &#39;priorityHandlerProcess&#39; : &#39;standardHandlerProcess&#39;)}" camunda:calledElementExpression="${classificationType == &#39;URGENT&#39; ? &#39;urgentHandlerProcess&#39; : (classificationType == &#39;PRIORITY&#39; ? &#39;priorityHandlerProcess&#39; : &#39;standardHandlerProcess&#39;)}">
      <bpmn:extensionElements>
        <camunda:in source="requestAmount" target="requestAmount" />
        <camunda:in source="classificationType" target="classificationType" />
        <camunda:out source="handledBy" target="handledBy" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_1" name="Routed">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="BusinessRuleTask_Classify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="BusinessRuleTask_Classify" targetRef="CallActivity_RouteToHandler" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CallActivity_RouteToHandler" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="classificationRoutingProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="152" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="130" y="146" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BusinessRuleTask_Classify_di" bpmnElement="BusinessRuleTask_Classify">
        <omgdc:Bounds x="240" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_RouteToHandler_di" bpmnElement="CallActivity_RouteToHandler">
        <omgdc:Bounds x="400" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="560" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="551" y="146" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="188" y="118" />
        <omgdi:waypoint x="240" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="118" />
        <omgdi:waypoint x="400" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="500" y="118" />
        <omgdi:waypoint x="560" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
