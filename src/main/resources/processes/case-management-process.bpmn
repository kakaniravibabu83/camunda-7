      <bpmndi:BPMNEdge id="SubFlow_FromFinanceApproval_di" bpmnElement="SubFlow_FromFinanceApproval">
        <omgdi:waypoint x="780" y="600" />
        <omgdi:waypoint x="1170" y="600" />
        <omgdi:waypoint x="1170" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_FromProcurement_di" bpmnElement="SubFlow_FromProcurement">
        <omgdi:waypoint x="780" y="710" />
        <omgdi:waypoint x="1090" y="710" />
        <omgdi:waypoint x="1090" y="435" />
        <omgdi:waypoint x="1152" y="435" />
