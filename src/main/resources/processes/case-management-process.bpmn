        <omgdi:waypoint x="570" y="490" />
        <omgdi:waypoint x="680" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_ToFinanceApproval_di" bpmnElement="SubFlow_ToFinanceApproval">
        <omgdi:waypoint x="400" y="460" />
        <omgdi:waypoint x="400" y="600" />
        <omgdi:waypoint x="680" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_ToProcurement_di" bpmnElement="SubFlow_ToProcurement">
        <omgdi:waypoint x="425" y="435" />
        <omgdi:waypoint x="460" y="435" />
        <omgdi:waypoint x="460" y="710" />
        <omgdi:waypoint x="680" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_FromSam_di" bpmnElement="SubFlow_FromSam">
        <omgdi:waypoint x="780" y="160" />
        <omgdi:waypoint x="1170" y="160" />
        <omgdi:waypoint x="1170" y="417" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_FromBusinessConfirmation_di" bpmnElement="SubFlow_FromBusinessConfirmation">
