        <omgdi:waypoint x="1152" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_FromLegalReview_di" bpmnElement="SubFlow_FromLegalReview">
        <omgdi:waypoint x="780" y="349" />
        <omgdi:waypoint x="846" y="349" />
        <omgdi:waypoint x="846" y="520" />
        <omgdi:waypoint x="1170" y="520" />
        <omgdi:waypoint x="1170" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SubFlow_FromBusinessApproval_di" bpmnElement="SubFlow_FromBusinessApproval">
